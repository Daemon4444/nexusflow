{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "runtime", "backend", "frontend", "gateway", "ingress"],
  "properties": {
    "images": {
      "type": "object",
      "required": ["backend", "frontend", "gateway"],
      "properties": {
        "backend": { "$ref": "#/definitions/image" },
        "frontend": { "$ref": "#/definitions/image" },
        "gateway": { "$ref": "#/definitions/image" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["existingSecret", "backendUrl", "shutdownTimeoutMs", "sseHeartbeatIntervalMs"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "backendUrl": { "type": "string", "pattern": "^http://[a-z0-9.-]+:[0-9]+$" },
        "shutdownTimeoutMs": { "type": "integer", "minimum": 10000, "maximum": 540000 },
        "sseHeartbeatIntervalMs": { "type": "integer", "minimum": 5000, "maximum": 45000 }
      }
    },
    "backend": { "$ref": "#/definitions/workload" },
    "frontend": { "$ref": "#/definitions/workload" },
    "gateway": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["existingAuthSecret", "trustedProxyCidrs"],
          "properties": {
            "existingAuthSecret": { "type": "string", "minLength": 1 },
            "trustedProxyCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
              }
            }
          }
        }
      ]
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "albConfigName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "albConfigName": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "albConfigName": { "minLength": 1 } } }
        }
      ]
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicas", "eciSpecs", "computeCategory", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2 },
        "eciSpecs": { "type": "string", "minLength": 1 },
        "computeCategory": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 2 },
            "maxReplicas": { "type": "integer", "minimum": 2 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
            "inflight": {
              "type": "object",
              "required": ["enabled", "metricName", "targetAverageValue"],
              "properties": {
                "enabled": { "type": "boolean" },
                "metricName": { "type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$" },
                "targetAverageValue": { "type": "string", "pattern": "^[1-9][0-9]*$" }
              }
            }
          }
        }
      }
    }
  }
}

{
  "name": "ai-router-platform",
  "version": "1.0.0",
  "description": "AI模型聚合平台 - 模仿OpenRouter",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test:release-telemetry": "node scripts/test-release-telemetry.mjs",
    "test:release-telemetry-reconcile": "node scripts/test-reconcile-release-telemetry.mjs",
    "test:release-primitives": "bash scripts/test-release-primitives.sh",
    "test:provider-cost-release": "node scripts/test-provider-cost-release.mjs",
    "test:deploy-orchestrator-state": "node scripts/test-deploy-orchestrator-state.mjs",
    "reconcile:release-telemetry": "node scripts/reconcile-release-telemetry.mjs"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "urllib": "4.9.1",
    "next": {
      ".": "16.3.4",
      "postcss": "8.5.28",
      "sharp": "0.35.4"
    },
    "@alicloud/log@1.2.6": {
      "protobufjs": "8.7.1"
    }
  }
}

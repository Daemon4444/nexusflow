{
  "name": "backend",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo \"Use npm run test:smoke\" && exit 1",
    "test:smoke": "ts-node scripts/smoke.ts",
    "test:billing": "USE_PG_MEM=true ts-node scripts/test-billing-reservations.ts",
    "test:provider-monitor": "ts-node scripts/test-provider-monitor-semantics.ts && USE_PG_MEM=true ts-node scripts/test-provider-health-schema.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:pg:migrate": "ts-node src/db/migrate.ts",
    "db:pg:copy": "ts-node src/db/copy-sqlite-to-pg.ts",
    "db:pg:verify": "ts-node src/db/verify-pg.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Quadrant AI Router Platform Backend",
  "dependencies": {
    "@alicloud/credentials": "^2.4.4",
    "@alicloud/log": "^1.2.6",
    "@alicloud/dysmsapi20170525": "^4.5.0",
    "@alicloud/openapi-client": "^0.4.15",
    "alipay-sdk": "^4.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "ioredis": "^5.4.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.11",
    "pg-mem": "^3.0.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

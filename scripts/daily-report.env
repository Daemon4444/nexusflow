# NexusFlow Daily Report Configuration
# Copy this file to customize your webhook and database settings.

# Webhook URL (required for pushing reports)
# Supports: WeChat Work, DingTalk, Feishu/Lark, or any generic JSON webhook
DAILY_REPORT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/351e83d7-de43-4a02-98ad-52adc21df8ae

# PostgreSQL connection (optional, defaults match backend .env)
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_USER=quadrant
# PG_PASSWORD=quadrant_dev_password
# PG_DATABASE=quadrant

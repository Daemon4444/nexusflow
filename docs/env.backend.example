# Copy to backend/.env and fill values from the secret store.
# Never commit backend/.env.

NODE_ENV=production
PORT=3001
PUBLIC_BASE_URL=https://nexusflow.vip
BACKEND_URL=https://nexusflow.vip

# Database
DATABASE_URL=postgres://quadrant:<password>@127.0.0.1:5432/quadrant
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=quadrant
PG_PASSWORD=<from-secret-store>
PG_DATABASE=quadrant
PG_POOL_MAX=10
USE_PG_MEM=false

# Redis / rate limiting
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<from-secret-store>

# Admin / local bootstrap
ADMIN_EMAILS=<comma-separated-emails>
ADMIN_USER_IDS=<comma-separated-user-ids>
ENABLE_SEED_API_KEYS=false
ENABLE_MOCK_PAYMENT=false
PROVIDER_SECRET_KEY=<from-secret-store>

# Auth
GOOGLE_CLIENT_ID=<google-oauth-client-id>

# Upstream providers
DASHSCOPE_API_KEY=<from-secret-store>
DASHSCOPE_BASE_URL=<dashscope-compatible-base-url>
DASHSCOPE_INTL_API_KEY=<from-secret-store>
DASHSCOPE_INTL_WORKSPACE_ID=<workspace-id>
DASHSCOPE_US_API_KEY=<from-secret-store>
DASHSCOPE_EU_API_KEY=<from-secret-store>
DASHSCOPE_EU_WORKSPACE_ID=<workspace-id>
ANTHROPIC_API_KEY=<from-secret-store>
ARK_API_KEY=<from-secret-store>
PIXVERSE_API_KEY=<from-secret-store>

# Alipay
ALIPAY_APP_ID=<from-secret-store>
ALIPAY_PRIVATE_KEY=<from-secret-store>
ALIPAY_PUBLIC_KEY=<from-secret-store>
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://nexusflow.vip/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://nexusflow.vip/billing
ALIPAY_EXPECT_APP_ID=<optional-safety-check>
ALIPAY_EXPECT_SELLER_ID=<optional-safety-check>

# Email / SMS / logs
SMTP_HOST=<smtp-host>
SMTP_PORT=587
